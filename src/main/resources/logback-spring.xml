<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
	<property name="LOG_DIR" value="./logs"/>
	<property name="APP_NAME" value="geh-app"/>
	<property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId}] %logger{36} - %msg%n"/>

	<!-- 콘솔 출력 -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<!-- 기본 System.out 으로 출력; 필요하면 <target>System.err</target>로 변경 -->
		<encoder>
			<pattern>${PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- 전체 로그(일+용량) -->
	<appender name="FILE_ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/${APP_NAME}.log</file>
		<encoder>
			<pattern>${PATTERN}</pattern>
		</encoder>

		<!-- 권장: SizeAndTimeBasedRollingPolicy 사용 -->
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- 하루 단위 + 인덱스 + gzip -->
			<fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>

			<!-- 보관 일수 -->
			<maxHistory>30</maxHistory>

			<!-- 전체 폴더 용량 상한 -->
			<totalSizeCap>5GB</totalSizeCap>

			<!-- 파일당 최대 크기 (SizeAndTimeBasedRollingPolicy에서 직접 설정) -->
			<maxFileSize>200MB</maxFileSize>
		</rollingPolicy>
	</appender>

	<!-- ERROR 전용 -->
	<appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/${APP_NAME}-error.log</file>
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>ERROR</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<encoder>
			<pattern>${PATTERN}</pattern>
		</encoder>

		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxHistory>60</maxHistory>
			<totalSizeCap>2GB</totalSizeCap>
			<maxFileSize>50MB</maxFileSize>
		</rollingPolicy>
	</appender>

	<!-- 비동기 (파일 쓰기 성능 개선) -->
	<appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
		<queueSize>8192</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<appender-ref ref="FILE_ROLLING"/>
	</appender>

	<appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
		<queueSize>4096</queueSize>
		<appender-ref ref="FILE_ERROR"/>
	</appender>

	<!-- root: 콘솔 + 파일(비동기) 둘 다 연결 -->
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="ASYNC_FILE"/>
		<appender-ref ref="ASYNC_ERROR"/>
	</root>

	<!-- 패키지별 로깅 레벨 -->
	<logger name="com.example.geh" level="DEBUG"/>
	<logger name="org.springframework" level="INFO"/>
</configuration>
